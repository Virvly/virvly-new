---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
const clientsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Find Your Photos — Instant AI Face Matching | Virvly",
  "description": "Find and download your event photos in seconds. Upload a quick selfie to find your photos with Virvly's secure, privacy-first facial matching.",
  "url": "https://virvly.com/clients/"
};
---

<Layout 
  title="Find Your Photos — Instant AI Face Matching | Virvly"
  description="Find and download your event photos in seconds. Upload a quick selfie to find your photos with Virvly's secure, privacy-first facial matching."
  jsonLd={clientsSchema}
>
  <!-- Scrollable page container -->
  <div class="relative min-h-screen bg-brand-paper select-none font-body text-brand-charcoal overflow-x-hidden">
    
    <!-- HEADER -->
    <Header activePage="clients" />

    <!-- HERO SECTION -->
    <section class="relative min-h-screen md:min-h-[96vh] flex items-center justify-start pt-24 pb-16 md:pt-32 md:pb-24 text-white overflow-hidden">
      <!-- Background Image -->
      <img 
        src="/images/client-hero.jpg" 
        alt="Customers smiling outdoor photo" 
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Dark scrim overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue-deep/55 via-brand-blue-deep/70 to-brand-blue-deep/95 z-10"></div>

      <!-- Wrap Content -->
      <div class="wrap relative z-20 flex flex-col items-start text-left max-w-3xl px-4 mt-8 md:mt-12">
        <span class="font-heading font-extrabold text-[13px] tracking-widest text-white uppercase block mb-3">
          LOOKING FOR YOUR PHOTOS?
        </span>
        <h1 class="font-heading font-extrabold text-white text-[38px] sm:text-[48px] md:text-[56px] leading-tight sm:leading-[1.1] tracking-tight mb-4 sm:mb-6 max-w-xl">
          Find yourself in photographs taken with <span class="text-brand-orange">Virvly</span>
        </h1>
        <p class="hidden md:block font-body text-xl leading-relaxed sm:leading-[1.6] text-white max-w-xl mb-8 sm:mb-10">
          Use a selfie to find photographs you're in, then choose and buy the ones you want. You'll only see photographs matched to you.
        </p>

        <!-- Dynamic Anchor CTA Button -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-6 sm:mb-8 w-full sm:w-auto">
          <Button 
            href="https://client.virvly.com" target='_blank' rel='noopener noreferrer'
            variant="primary" 
            class="w-auto text-[15px] sm:text-base px-8 py-3.5 sm:py-4 shadow-lg shadow-brand-orange/20 animate-fade-in"
          >
            Find my photos <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
        </div>

        <p class="text-sm sm:text-base text-white/90">
          Wondering how your selfie is handled? 
        </p>
        <a href="#privacy" class="font-semibold text-brand-orange hover:text-brand-orange-light hover:underline transition-colors">See our privacy approach &rarr;</a>
      </div>
    </section>

    <!-- COMPREHENSIVE PRIVACY APPROACH SECTION -->
    <section class="py-16 md:py-20 bg-brand-paper scroll-mt-16" id="privacy">
      <div class="wrap max-w-4xl">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="font-heading font-extrabold text-[12px] md:text-[13px] tracking-widest text-brand-blue uppercase block mb-3">
            Privacy First
          </span>
          <h2 class="font-heading font-extrabold text-[32px] sm:text-[38px] md:text-[42px] leading-tight text-brand-charcoal">
            How we handle your face
          </h2>
          <p class="font-body text-[15px] sm:text-[16px] leading-relaxed text-brand-grey-1 mt-4">
            At Virvly, privacy is not an afterthought — it is a foundational architectural pillar. Here is exactly how we treat your biometric information.
          </p>
        </div>

        <!-- Privacy Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Shield Card 1: Strictly Transient -->
          <div class="bg-white border border-black/5 p-6 sm:p-8 rounded-2xl shadow-sm flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-brand-blue/5 text-brand-blue flex items-center justify-center">
              <!-- Transient / Time SVG Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-[17px] sm:text-[18px] text-brand-charcoal mb-2">Strictly Transient Processing</h3>
              <p class="font-body text-[13.5px] leading-relaxed text-brand-grey-1">
                Your uploaded selfie or capture is processed temporarily in secure server memory to generate matching coordinates, then immediately and permanently discarded.
              </p>
            </div>
          </div>

          <!-- Shield Card 2: No Storage -->
          <div class="bg-white border border-black/5 p-6 sm:p-8 rounded-2xl shadow-sm flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-brand-blue/5 text-brand-blue flex items-center justify-center">
              <!-- Hard Drive / Database block Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m16.5 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 7.5m16.5 0V4.5A2.25 2.25 0 0 0 17.25 2.25H6.75A2.25 2.25 0 0 0 4.5 4.5V7.5"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-[17px] sm:text-[18px] text-brand-charcoal mb-2">No Permanent Biometrics</h3>
              <p class="font-body text-[13.5px] leading-relaxed text-brand-grey-1">
                We never store your selfie or build persistent face databases. We compile only anonymised visual vector points which cannot be reversed to identify you.
              </p>
            </div>
          </div>

          <!-- Shield Card 3: Encrypted in Transit -->
          <div class="bg-white border border-black/5 p-6 sm:p-8 rounded-2xl shadow-sm flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-brand-blue/5 text-brand-blue flex items-center justify-center">
              <!-- Lock / Encryption SVG Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0V10.5m-3.111 1.25H18.9m-16.511 0A2.25 2.25 0 0 0 3 13.5v5.17c0 .596.355 1.127.91 1.341l.001.001a14.707 14.707 0 0 0 16.178 0c.553-.213.908-.744.908-1.34V13.5a2.25 2.25 0 0 0-2.247-2.25H3.389z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-[17px] sm:text-[18px] text-brand-charcoal mb-2">Fully Encrypted Transfers</h3>
              <p class="font-body text-[13.5px] leading-relaxed text-brand-grey-1">
                Your data is transferred using end-to-end SSL/TLS encryption. All matches happen inside enterprise-grade firewalled environments.
              </p>
            </div>
          </div>

          <!-- Shield Card 4: Complete User Control -->
          <div class="bg-white border border-black/5 p-6 sm:p-8 rounded-2xl shadow-sm flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-brand-blue/5 text-brand-blue flex items-center justify-center">
              <!-- Eye / View SVG Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-[17px] sm:text-[18px] text-brand-charcoal mb-2">Total Search Control</h3>
              <p class="font-body text-[13.5px] leading-relaxed text-brand-grey-1">
                You only see matches of yourself. No other users can search for your photos, and photographers do not receive your facial metrics or personal details.
              </p>
            </div>
          </div>

        </div>

        <!-- Button leading to the Privacy Policy page -->
        <div class="mt-12 text-center">
          <Button 
            href="/privacy" 
            variant="secondary" 
            animateArrow={true}
            class="text-sm md:text-base px-8 md:px-14 py-3.5 md:py-4 shadow-md shadow-brand-blue/20 capitalize"
          >
            Read our full privacy policy
          </Button>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer />

  </div>
</Layout>
