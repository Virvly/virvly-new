---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service — Platform Usage & Photo Licensing | Virvly",
  "description": "Read the Virvly Terms of Service covering photographer accounts, client photo purchases, copyright ownership, licensing, and acceptable use.",
  "url": "https://virvly.com/terms/",
  "dateModified": "2026-09-14"
};
---

<Layout 
  title="Terms of Service — Platform Usage & Photo Licensing | Virvly"
  description="Read the Virvly Terms of Service covering photographer accounts, client photo purchases, copyright ownership, licensing, and acceptable use."
  jsonLd={termsSchema}
>
  <!-- Scrollable page container -->
  <div class="relative min-h-screen bg-brand-paper font-body text-brand-charcoal overflow-x-hidden">
    
    <!-- HEADER -->
    <Header activePage="terms" />

    <!-- HERO HEADER SECTION -->
    <section class="relative min-h-[40vh] flex items-center justify-center pt-28 pb-16 md:pt-36 md:pb-20 text-white overflow-hidden bg-brand-blue-deep">
      <!-- Background overlay elements -->
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue-deep/50 via-brand-blue-deep/80 to-brand-blue-deep/98 z-10"></div>
      
      <!-- Hero Content -->
      <div class="wrap relative z-20 flex flex-col items-center text-center max-w-3xl px-4">
        <span class="font-heading font-extrabold text-[12px] md:text-[13px] tracking-widest text-brand-orange uppercase block mb-3">
          Legal Agreement
        </span>
        <h1 class="font-heading font-extrabold text-[36px] sm:text-[44px] md:text-[48px] leading-tight tracking-tight text-white mb-2">
          Terms of Service
        </h1>
       <p class="font-body text-sm leading-relaxed text-white max-w-xl">
          Last updated: August 28, 2026
        </p>
      </div>
    </section>

    <!-- LEGAL DOCUMENT CONTAINER -->
    <section class="py-16 bg-white relative z-20 -mt-8 rounded-t-3xl shadow-2xl">
      <div class="max-w-4xl mx-auto">
        <div class="prose max-w-none text-[15.5px] leading-relaxed text-brand-grey-1 space-y-12 font-body">
          
          <div class="border-b border-black/5 pb-8 space-y-4">
            <p class="font-semibold text-brand-charcoal text-[17px]">
              Welcome to Virvly. Please read these Terms of Service carefully before using our platform.
            </p>
            <p>
              These Terms of Service ("Terms") constitute a legally binding agreement made between you, whether personally or on behalf of an entity ("you" or "user") and Virvly ("we," "us," or "our"), concerning your access to and use of the website (<a href="/" class="text-brand-blue font-semibold hover:underline">virvly.com</a>) and our web application (collectively, the "Platform").
            </p>
            <p>
              By accessing or using the Platform, you acknowledge that you have read, understood, and agree to be bound by all of these Terms. If you do not agree with all of these Terms, you are prohibited from using the Platform.
            </p>
          </div>

          <!-- Section 1 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">1. Description of Platform Services</h2>
            <p>
              Virvly is a marketplace platform that enables roaming, event, and landscape photographers ("Photographers") to upload digital photographs, and enables clients, tourists, or event participants ("Customers") to discover and purchase copies of those photographs. Discoverability is enhanced via our interactive face-matching technology, which matches a temporarily uploaded portrait with photographs containing that customer.
            </p>
          </div>

          <!-- Section 2 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">2. User Registration and Accounts</h2>
            <ul class="list-disc pl-6 space-y-4">
              <li>
                <strong class="text-brand-charcoal">Photographer Accounts:</strong> Photographers must register an account and connect a valid payout mechanism (via our partner, Stripe) to receive transaction fees. You are responsible for maintaining the confidentiality of your credentials and all activities on your account.
              </li>
              <li>
                <strong class="text-brand-charcoal">Accuracy of Details:</strong> You agree to provide true, current, and complete details during registration and throughout your use of the Platform.
              </li>
              <li>
                <strong class="text-brand-charcoal">Termination:</strong> We reserve the right to suspend or terminate accounts that violate these Terms, provide fraudulent details, or infringe upon the rights of others.
              </li>
            </ul>
          </div>

          <!-- Section 3 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">3. Intellectual Property & Copyright</h2>
            <ul class="list-disc pl-6 space-y-4">
              <li>
                <strong class="text-brand-charcoal">Photographer Ownership:</strong> Photographers retain full copyright and ownership of the original photographs they upload to the Platform.
              </li>
              <li>
                <strong class="text-brand-charcoal">Licence to Purchaser:</strong> Upon successful purchase and transaction clearing, the Photographer grants the Customer a perpetual, non-exclusive, non-transferable, personal-use licence to download and print the purchased photograph. Commercial distribution, resale, or sublicensing is strictly prohibited unless explicitly agreed in writing by the Photographer.
              </li>
              <li>
                <strong class="text-brand-charcoal">Watermarks:</strong> Unpurchased digital photographs displayed in the preview gallery will be watermarked. Circumventing, cropping, or stripping watermarks from previews is a direct violation of these Terms and copyright law.
              </li>
            </ul>
          </div>

          <!-- Section 4 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">4. Fees, Pricing & Stripe Transactions</h2>
            <p>
              Transactions on Virvly are handled securely and transparently.
            </p>
            <ul class="list-disc pl-6 space-y-4">
              <li>
                <strong class="text-brand-charcoal">Photographer-Set Pricing:</strong> Photographers have complete freedom to set the selling price of their photographs.
              </li>
              <li>
                <strong class="text-brand-charcoal">Platform Commissions:</strong> We charge a service fee (commission) on completed sales to cover hosting, maintenance, administrative, and payment processing costs. Platform commission rates are clearly outlined in the Photographer Dashboard before photo uploading.
              </li>
              <li>
                <strong class="text-brand-charcoal">No-Refund Policy:</strong> Due to the digital nature of instant photograph downloads, all cleared purchases are final and non-refundable. If a file is corrupt or a matching error occurs, please contact Support within 7 days for assistance.
              </li>
            </ul>
          </div>

          <!-- Section 5 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">5. Prohibited Conduct</h2>
            <p>
              As a user of the Platform, you agree not to:
            </p>
            <ul class="list-disc pl-6 space-y-4">
              <li>Upload photographs or material that is illegal, abusive, obscene, harassing, defamatory, or infringes on any proprietary right or third-party trademark.</li>
              <li>Upload photos containing individuals without having acquired standard professional consent, or upload photographs of minors where prohibited by local jurisdictions.</li>
              <li>Bypass, disable, or interfere with security features of the Platform or the image watermarking mechanisms.</li>
              <li>Attempt to scrape, reverse-engineer, or extract facial-matrix indexing datasets from our AI face matching application.</li>
            </ul>
          </div>

          <!-- Section 6 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">6. Disclaimer of Warranties</h2>
            <p>
              The Platform is provided on an "as-is" and "as-available" basis. We make no warranties or representations about the accuracy, reliability, or completeness of the Platform's content, or of our face-matching algorithm matching 100% of photos. We assume no liability for any errors, omissions, server downtimes, or unauthorised access to our secure servers.
            </p>
          </div>

          <!-- Section 7 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">7. Limitation of Liability</h2>
            <p>
              In no event shall Virvly, our directors, employees, or agents be liable to you or any third party for any direct, indirect, consequential, exemplary, incidental, or punitive damages, including lost profits, lost revenue, or loss of data arising from your use of the Platform, even if we have been advised of the possibility of such damages.
            </p>
          </div>

          <!-- Section 8 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">8. Governing Law</h2>
            <p>
              These Terms and your use of the Platform are governed by and construed in accordance with the laws of the jurisdiction in which the Platform operations are registered, without regard to its conflict of law principles.
            </p>
          </div>

          <!-- Section 9 -->
          <div class="space-y-5">
            <h2 class="font-heading font-extrabold text-xl text-brand-charcoal border-b border-black/5 pb-2">9. Contact Us</h2>
            <p>
              In order to resolve a complaint regarding the Platform or to receive further information regarding its use, please write to us at:
            </p>
            <div class="bg-brand-paper-2 border border-black/5 rounded-xl p-5 mt-3 space-y-2">
              <p class="font-heading font-bold text-brand-charcoal text-[15.5px]">Virvly Legal Affairs Department</p>
              <p class="text-[14px]">Email: <a href="mailto:legal@virvly.com" class="text-brand-blue hover:underline font-semibold font-mono">legal@virvly.com</a></p>
              <p class="text-[14px]">Alternate: <a href="mailto:hello@virvly.com" class="text-brand-blue hover:underline font-semibold font-mono">hello@virvly.com</a></p>
              <p class="text-[14px] pt-2 text-brand-grey-2 border-t border-black/5">You can also use our <a href="/contact" class="text-brand-orange hover:underline font-semibold">contact page</a> to submit an enquiry.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer />

  </div>
</Layout>
