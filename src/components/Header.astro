---
import Button from './Button.astro';

interface Props {
  activePage?: 'home' | 'clients' | 'contact' | 'privacy' | 'terms' | 'other';
}

const { activePage = 'home' } = Astro.props;
---

<header 
  id="hdr" 
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-ease py-5 md:py-6 bg-transparent"
>
  <div class="wrap flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a 
      href="/" 
      class="flex items-center hover:opacity-95 transition-opacity z-50"
      aria-label="Virvly Homepage"
    >
      <img 
        src="/brand/virvly-logo.png" 
        alt="Virvly Logo" 
        class="h-9 md:h-11 w-auto logo-img transition-all duration-300 ease-ease mt-1"
      />
    </a>
 
    <!-- Action Buttons (Desktop/Tablet) -->
    <div class="hidden sm:flex items-center gap-3 md:gap-4">
      {activePage === 'home' && (
        <>
          <Button 
            variant="ghost" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-none hover:scale-100 inactive-btn"
          >
            For Photographers 
          </Button>
          <Button 
            href="/clients" 
            variant="primary" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-md hover:scale-[1.02]"
          >
           For Clients <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
        </>
      )}
      {activePage === 'clients' && (
        <>
          <Button 
            variant="ghost" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-none hover:scale-100 inactive-btn"
          >
            For Clients
          </Button>
          <Button 
            href="/" 
            variant="primary" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-md hover:scale-[1.02]"
          >
            For Photographers <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
        </>
      )}
      {activePage !== 'home' && activePage !== 'clients' && (
        <>
          <Button 
            href="/"
            variant="ghost" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-none hover:scale-[1.02] nav-link-secondary"
          >
            For Photographers
          </Button>
          <Button 
            href="/clients" 
            variant="primary" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-md hover:scale-[1.02]"
          >
            For Clients <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
        </>
      )}
    </div>

    <!-- Hamburger Button (Mobile) -->
    <button 
      id="menu-toggle" 
      class="sm:hidden flex items-center justify-center size-12 rounded-full text-white bg-white/10 border border-white/20 hover:bg-white/20 focus:outline-none z-50 transition-all duration-300"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg 
        id="menu-icon"
        class="size-7" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="2.5"
      >
        <path id="burger-line-1" d="M4 6h16" stroke-linecap="round"></path>
        <path id="burger-line-2" d="M4 12h16" stroke-linecap="round"></path>
        <path id="burger-line-3" d="M4 18h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 bg-brand-blue-deep z-40 flex flex-col items-center justify-center p-6 sm:p-8 transition-all duration-300 ease-ease -translate-y-full opacity-0 invisible overflow-y-auto"
>
  <div class="flex flex-col items-center gap-5 w-full max-w-[280px] text-center my-auto pt-20 pb-8">
    <!-- Main Page Links -->
    <a 
      href="/" 
      class={`text-xl font-heading font-semibold transition-colors ${activePage === 'home' ? 'text-brand-orange' : 'text-white/80 hover:text-white'}`}
    >
      Home
    </a>
    <a 
      href="https://client.virvly.com" target='_blank' rel='noopener noreferrer'
      class={`text-xl font-heading font-semibold transition-colors ${activePage === 'clients' ? 'text-brand-orange' : 'text-white/80 hover:text-white'}`}
    >
      Find My Photos
    </a>
    <a 
      href="/contact" 
      class={`text-xl font-heading font-semibold transition-colors ${activePage === 'contact' ? 'text-brand-orange' : 'text-white/80 hover:text-white'}`}
    >
      Contact Us
    </a>
    
    <!-- Divider -->
    <div class="w-12 h-[1px] bg-white/10 my-2"></div>
    
    <!-- Secondary Legal Links -->
    <a 
      href="/privacy" 
      class={`text-base font-body transition-colors ${activePage === 'privacy' ? 'text-brand-orange font-semibold' : 'text-white/60 hover:text-white'}`}
    >
      Privacy Policy
    </a>
    <a 
      href="/terms" 
      class={`text-base font-body transition-colors ${activePage === 'terms' ? 'text-brand-orange font-semibold' : 'text-white/60 hover:text-white'}`}
    >
      Terms of Service
    </a>

    <!-- Quick Action Button -->
    <div class="w-full mt-4">
      {activePage === 'home' ? (
        <Button 
          href="/clients" 
          variant="primary" 
          class="text-base px-6 py-3.5 w-full text-center shadow-lg shadow-brand-orange/20"
        >
          For Clients &rarr;
        </Button>
      ) : (
        <Button 
          href="/" 
          variant="primary" 
          class="text-[14px] px-6 py-3.5 w-full text-center shadow-lg shadow-brand-orange/20"
        >
          For Photographers &rarr;
        </Button>
      )}
    </div>
  </div>
</div>

<style is:global>
  /* Header scroll transition standards */
  #hdr.scrolled {
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 14px;
    padding-bottom: 14px;
  }

  /* Logo transitions */
  #hdr .logo-img {
    filter: brightness(0) invert(1);
  }

  #hdr.scrolled .logo-img {
    filter: none;
  }

  #hdr.scrolled .nav-link-secondary {
    color: #4A4A4A !important;
  }

  #hdr.scrolled .nav-link-secondary:hover {
    color: #F78C1E !important;
  }

  /* Inactive button styles */
  #hdr .inactive-btn {
    background-color: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: rgba(255, 255, 255, 0.85) !important;
    pointer-events: none;
    cursor: default;
  }

  #hdr.scrolled .inactive-btn {
    background-color: rgba(28, 28, 28, 0.05) !important;
    border-color: rgba(28, 28, 28, 0.06) !important;
    color: rgba(28, 28, 28, 0.5) !important;
  }

  /* Mobile Menu Styles */
  #mobile-menu {
    background-color: #053349 !important; /* Force complete solid, opaque background to fully cover content underneath */
    min-height: 100dvh;
  }

  #mobile-menu.open {
    transform: translateY(0) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* When mobile menu is open, ensure header stays transparent and unblurred so only white logo & close toggle show over dark overlay */
  #hdr.menu-open {
    background-color: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
    border-bottom-color: transparent !important;
  }

  #hdr.menu-open .logo-img {
    filter: brightness(0) invert(1) !important;
  }

  #hdr.menu-open #menu-toggle {
    color: #FFFFFF !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
    background-color: rgba(255, 255, 255, 0.1) !important;
  }

  #menu-toggle.open #burger-line-1 {
    transform: translateY(6px) rotate(45deg);
  }
  #menu-toggle.open #burger-line-2 {
    opacity: 0;
  }
  #menu-toggle.open #burger-line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }
  #menu-toggle #burger-line-1,
  #menu-toggle #burger-line-2,
  #menu-toggle #burger-line-3 {
    transform-origin: 12px 12px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #hdr.scrolled #menu-toggle:not(.open) {
    color: #1C1C1C;
    border-color: rgba(28, 28, 28, 0.15);
    background-color: rgba(28, 28, 28, 0.05);
  }
</style>

<script>
  // Handle passive scroll interaction for the header background
  const header = document.getElementById('hdr');
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    };

    // Add passive event listener for performance
    window.addEventListener('scroll', handleScroll, { passive: true });
    // Run once on load to ensure state correctness
    handleScroll();
  }

  // Handle mobile menu interaction
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      mobileMenu.classList.remove('open');
      menuToggle.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      if (header) {
        header.classList.remove('menu-open');
      }
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      mobileMenu.classList.add('open');
      menuToggle.classList.add('open');
      menuToggle.setAttribute('aria-expanded', 'true');
      if (header) {
        header.classList.add('menu-open');
      }
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    };

    menuToggle.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close mobile menu on clicking any links inside it
    const mobileMenuLinks = mobileMenu.querySelectorAll('a');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close mobile menu if header logo is clicked
    const headerLogo = header ? header.querySelector('a') : null;
    if (headerLogo) {
      headerLogo.addEventListener('click', () => {
        if (mobileMenu.classList.contains('open')) {
          closeMenu();
        }
      });
    }

    // Close mobile menu when pressing Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
        menuToggle.focus();
      }
    });

    // Close mobile menu if window is resized past mobile breakpoint
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 640 && mobileMenu.classList.contains('open')) {
        closeMenu();
      }
    });
  }
</script>
