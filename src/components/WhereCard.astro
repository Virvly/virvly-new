---
interface Props {
  title: string;
  image: string;
}

const { title, image } = Astro.props;
---

<div class="relative aspect-[4/5] rounded-2xl overflow-hidden group shadow-sm bg-brand-paper-2 border border-black/5">
  <!-- Grid Card Image -->
  <img 
    src={image} 
    alt={title} 
    class="object-cover absolute inset-0 w-full h-full transition-transform duration-700 ease-ease group-hover:scale-105"
    loading="lazy"
    decoding="async"
  />
  <!-- Elegant Scrim Gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-brand-blue-deep/90 via-brand-blue-deep/20 to-transparent z-10"></div>
  
  <!-- Content Label -->
  <div class="absolute bottom-3.5 left-3.5 right-3 z-20">
    <h3 class="font-heading font-bold text-[15px] text-white tracking-wide">
      {title}
    </h3>
  </div>
</div>
