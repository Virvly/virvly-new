---
---

<footer class="bg-brand-charcoal text-white pt-16 pb-10 border-t border-white/5">
  <div class="wrap">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 pb-12 border-b border-white/10">
      <!-- Brand Block -->
      <div class="md:col-span-6 max-w-sm">
        <a 
          href="/" 
          class="flex items-center hover:opacity-95 transition-opacity mb-4"
          aria-label="Virvly Homepage"
        >
          <img 
            src="/brand/virvly-logo.png" 
            alt="Virvly Logo" 
            class="h-9 md:h-11 w-auto brightness-0 invert mt-1"
          />
        </a>
        <p class="text-[14.5px] leading-relaxed text-white/60 font-body">
          Making it easier for photographers to connect potential clients with their photos and get paid.
        </p>
      </div>

      <!-- Links Columns -->
      <div class="md:col-span-6 grid grid-cols-2 gap-8 md:justify-items-end">
        <!-- Company Column -->
        <div class="flex flex-col gap-4">
          <h4 class="font-heading font-semibold text-[13px] uppercase tracking-wider text-white/40 mb-1">Company</h4>
          <a href="https://client.virvly.com" target="_blank" rel="noopener noreferrer" class="text-[14px] text-white/70 hover:text-brand-orange transition-colors">Find my photos</a>
          <a href="/contact" class="text-[14px] text-white/70 hover:text-brand-orange transition-colors">Contact</a>
          <a href="mailto:hello@virvly.com" class="text-[14px] text-white/70 hover:text-brand-orange transition-colors">hello@virvly.com</a>
        </div>

        <!-- Legal Column -->
        <div class="flex flex-col gap-4">
          <h4 class="font-heading font-semibold text-[13px] uppercase tracking-wider text-white/40 mb-1">Legal</h4>
          <a href="/privacy" class="text-[14px] text-white/70 hover:text-brand-orange transition-colors">Privacy policy</a>
          <a href="/terms" class="text-[14px] text-white/70 hover:text-brand-orange transition-colors">Terms of service</a>
        </div>
      </div>
    </div>

    <!-- Bottom Block -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-6 pt-8 text-[12.5px] text-white/40 font-body">
      <span class="text-center sm:text-left">© 2026 Virvly.</span>
      
      <!-- Social Icons -->
      <div class="flex items-center gap-3">
        <!-- LinkedIn -->
        <a 
          href="https://www.linkedin.com/company/virvly/" target="_blank" rel="noopener noreferrer"
          aria-label="LinkedIn" 
          class="size-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-brand-orange hover:border-brand-orange/50 hover:bg-brand-orange/10 transition-all duration-200"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.94 5a2 2 0 11-4-.02 2 2 0 014 .02zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z"/>
          </svg>
        </a>

        <!-- Facebook -->
        <a 
          href="https://www.facebook.com/Virvly/" target="_blank" rel="noopener noreferrer"
          aria-label="Facebook" 
          class="size-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-brand-orange hover:border-brand-orange/50 hover:bg-brand-orange/10 transition-all duration-200"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.5 21v-8.1h2.7l.4-3.15h-3.1V7.75c0-.91.25-1.53 1.56-1.53H16.7V3.4A22.1 22.1 0 0014.3 3.3c-2.4 0-4.05 1.46-4.05 4.15v2.32H7.5v3.15h2.75V21h3.25z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a 
          href="https://www.instagram.com/virvlyhq/" target="_blank" rel="noopener noreferrer"
          aria-label="Instagram" 
          class="size-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-brand-orange hover:border-brand-orange/50 hover:bg-brand-orange/10 transition-all duration-200"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a 
          href="https://wa.me/447495932478" target="_blank" rel="noopener noreferrer"
          aria-label="WhatsApp" 
          class="size-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-brand-orange hover:border-brand-orange/50 hover:bg-brand-orange/10 transition-all duration-200"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.02 2C6.78 2 2.53 6.25 2.53 11.49c0 1.85.53 3.58 1.44 5.04L2 22l5.62-1.92a9.44 9.44 0 004.4 1.08h.01c5.24 0 9.49-4.25 9.49-9.49C21.52 6.43 17.26 2 12.02 2zm5.5 13.4c-.23.65-1.34 1.24-1.85 1.3-.47.06-1.06.09-1.72-.11-.4-.12-.9-.29-1.55-.57-2.73-1.18-4.51-3.94-4.65-4.13-.14-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.27.25-.27.55-.34.73-.34h.53c.17 0 .4-.03.63.48.23.53.78 1.87.85 2 .07.14.11.3.02.48-.09.18-.14.29-.27.45-.14.16-.29.36-.41.48-.14.14-.28.28-.12.55.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.12.59-.05.16-.16.68-.79.86-1.06.18-.27.36-.22.6-.13.25.09 1.57.74 1.84.88.27.13.45.2.51.31.07.11.07.63-.16 1.28z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
