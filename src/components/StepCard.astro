---
interface Props {
  num: number | string;
  tag: string;
  title: string;
  image: string;
}

const { num, tag, title, image } = Astro.props;
---

<div class="flex flex-col gap-6 group">
  <!-- Step Image -->
  <div class="relative aspect-square w-full rounded-2xl overflow-hidden shadow-sm bg-brand-paper-2 border border-black/5">
    <img 
      src={image} 
      alt={`Step ${num}: ${title}`} 
      class="object-cover absolute inset-0 w-full h-full transition-transform duration-700 ease-ease group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <!-- Step Badge Number -->
    <div class="absolute top-3 left-3 z-10 size-7 rounded-full bg-brand-orange backdrop-blur-sm text-white font-heading font-bold text-[15px] flex items-center justify-center shadow-md">
      {num}
    </div>
  </div>

  <!-- Step Content -->
  <div class="flex flex-col gap-1.5">
    <span class="font-heading font-bold text-xs tracking-widest text-brand-orange uppercase">
      {tag}
    </span>
    <div class="space-y-1"> <h3 class="font-heading font-bold text-[17px] tracking-normal leading-tight text-brand-charcoal">
      {title}
    </h3>
   </div>
  </div>
</div>
