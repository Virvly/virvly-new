---
import BackToTop from '../components/BackToTop.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const { 
  title, 
  description = "Virvly enables photographers to connect customers with their photos and turn moments into sales.",
  canonicalURL: customCanonical,
  ogImage: customOgImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://virvly.com';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalURL = customCanonical || `${siteUrl}${currentPath}/`;
const ogImage = customOgImage 
  ? (customOgImage.startsWith('http') ? customOgImage : `${siteUrl}${customOgImage}`) 
  : `${siteUrl}/images/og-image.webp`;

const ogImageType = ogImage.endsWith('.png') ? 'image/png' : (ogImage.endsWith('.webp') ? 'image/webp' : 'image/jpeg');

// Base Schema.org Structured Data: Organization & WebSite
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Virvly",
  "legalName": "Virvly Ltd",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/brand/virvly-logo.png`,
    "caption": "Virvly Logo"
  },
  "description": "Virvly enables photographers to connect customers with their photos and turn moments into sales.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Plot 1184, Extension Layout",
    "addressLocality": "Gwagwalada, Abuja",
    "addressRegion": "Federal Capital Territory",
    "addressCountry": "NG"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "hello@virvly.com",
      "availableLanguage": ["English"]
    },
    {
      "@type": "ContactPoint",
      "contactType": "data protection officer",
      "email": "dpo@virvly.com",
      "availableLanguage": ["English"]
    }
  ],
  "sameAs": [
    "https://www.linkedin.com/company/virvly/",
    "https://www.facebook.com/Virvly/",
    "https://www.instagram.com/virvlyhq/"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Virvly",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "en-GB"
};

// Combine all JSON-LD schemas
const schemas: Array<Record<string, any>> = [organizationSchema, websiteSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    schemas.push(...jsonLd);
  } else {
    schemas.push(jsonLd);
  }
}
---

<!DOCTYPE html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00759F" />
    <meta name="apple-mobile-web-app-title" content="Virvly" />
    <meta name="application-name" content="Virvly" />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Virvly" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/virvly-logo.png" />

    <!-- Google Fonts Preconnect and Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" 
      rel="stylesheet" 
    />

    <!-- Structured Data (JSON-LD) -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="font-body bg-brand-paper text-brand-ink antialiased overflow-x-hidden min-h-screen flex flex-col">
    <!-- Accessibility: Skip to main content link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[999] focus:bg-brand-orange focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold focus:outline-none"
    >
      Skip to content
    </a>

    <main id="main-content" class="flex-grow flex flex-col">
      <slot />
    </main>

    <BackToTop />
    <Analytics />
  </body>
</html>

<style is:global>
  /* Base standards and custom helper classes */
  h1, h2, h3, h4 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    letter-spacing: -0.03em;
    color: #1C1C1C;
  }

  /* Custom styling standards */
  .wrap {
    width: 100%;
    max-width: 1180px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  @media (min-width: 760px) {
    .wrap {
      padding-left: 32px;
      padding-right: 32px;
    }
  }
</style>
